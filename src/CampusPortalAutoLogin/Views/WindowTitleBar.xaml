<UserControl x:Class="CampusPortalAutoLogin.Views.WindowTitleBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Height="42" Background="Transparent" MouseLeftButtonDown="DragWindow" MouseRightButtonUp="ShowSystemMenu">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False"><Path Data="M0,4 Q7,-2 14,4 M3,8 Q7,4 11,8 M7,11 L7,12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Width="16" Height="16" VerticalAlignment="Center"/><TextBlock Text="校园网自动登录" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0"/></StackPanel>
  <Button x:Name="MinimizeButton" Grid.Column="1" Style="{StaticResource CaptionButton}" Click="Minimize" AutomationProperties.Name="最小化" ToolTip="最小化"><Path Data="M0,5 L10,5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" Width="10" Height="10"/></Button>
  <Button x:Name="MaximizeButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Click="Maximize" AutomationProperties.Name="最大化或还原" ToolTip="最大化 / 还原"><Path Data="M0,0 L9,0 L9,9 L0,9 Z" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.1" Width="10" Height="10"/></Button>
  <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" AutomationProperties.Name="关闭窗口" ToolTip="关闭窗口"><Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2" Width="10" Height="10"/></Button>
 </Grid>
</UserControl>
