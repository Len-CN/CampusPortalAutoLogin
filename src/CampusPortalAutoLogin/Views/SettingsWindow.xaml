<Window x:Class="CampusPortalAutoLogin.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CampusPortalAutoLogin.ViewModels" xmlns:views="clr-namespace:CampusPortalAutoLogin.Views" xmlns:animations="clr-namespace:CampusPortalAutoLogin.Animations" Title="校园网自动登录设置" Width="440" Height="786" Style="{StaticResource GlassWindowStyle}">
<Border x:Name="WindowBorder" CornerRadius="24" BorderThickness="1" BorderBrush="#26FFFFFF" Background="{DynamicResource BackgroundBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Canvas Grid.RowSpan="2" x:Name="Lights" IsHitTestVisible="False" Opacity=".7"><Canvas.Effect><BlurEffect Radius="60"/></Canvas.Effect><Ellipse Width="420" Height="420" Fill="{x:Static animations:GlassMaterial.Moonlight}" Canvas.Left="-190" Canvas.Top="-210"/><Ellipse Width="360" Height="360" Fill="{x:Static animations:GlassMaterial.SteelLight}" Canvas.Left="240" Canvas.Top="320"/><Ellipse Width="220" Height="220" Fill="{x:Static animations:GlassMaterial.WarmLight}" Canvas.Left="280" Canvas.Top="-95"/></Canvas><Rectangle Grid.RowSpan="2" Fill="{x:Static animations:GlassMaterial.Noise}" IsHitTestVisible="False"/><Canvas x:Name="CursorLayer" Grid.RowSpan="2" IsHitTestVisible="False"><Ellipse x:Name="CursorAura" Width="96" Height="96" Fill="{StaticResource CursorAuraBrush}"/></Canvas><views:WindowTitleBar/><Grid Grid.Row="1" ClipToBounds="True">
  
  <Grid x:Name="Surface" Margin="24,18,24,18">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <StackPanel>
     <TextBlock Text="CAMPUS  /  CONNECT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
     <TextBlock x:Name="HeroTitle" Text="连接，交给它。" FontSize="25" FontWeight="SemiBold"/>
     <TextBlock Text="校园网自动登录 · 在后台保持连接" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,17"/>
     <animations:BeamBorder Style="{StaticResource GlassStatusBadgeStyle}" Margin="0,0,0,16">
      <StackPanel><DockPanel><TextBlock x:Name="StatusDot" Text="●" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/></DockPanel>
       <Button x:Name="PortalButton" Content="打开认证页面，人工完成验证 ↗" Visibility="Collapsed" HorizontalAlignment="Left" Height="28" Margin="0,8,0,0" Click="OpenPortal"/></StackPanel>
     </animations:BeamBorder>
     <animations:BeamBorder Padding="16" CornerRadius="24" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
      <StackPanel x:Name="AccountForm" IsEnabled="{Binding CanEdit}">
       <TextBlock Text="账号设置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,13"/>
       <TextBlock Text="用户名" Style="{StaticResource Caption}"/><TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="用户名" MaxLength="256" Margin="0,0,0,10"/>
       <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="密码" Style="{StaticResource Caption}"/><PasswordBox x:Name="PasswordInput" AutomationProperties.Name="密码" MaxLength="256"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="服务商" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Providers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ServiceProvider}" AutomationProperties.Name="服务商"/></StackPanel>
       </Grid>
       <TextBlock Text="密码使用 Windows 用户密钥加密保存" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,10,0,0"/>
      </StackPanel>
     </animations:BeamBorder>
     <animations:BeamBorder Padding="16" CornerRadius="24" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <StackPanel IsEnabled="{Binding CanEdit}">
       <TextBlock Text="自动运行" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
       <UniformGrid Columns="2" Margin="0,0,0,4"><CheckBox Content="开机自启" IsChecked="{Binding Autostart}"/><CheckBox Content="网络变化后登录" IsChecked="{Binding NetworkChange}"/></UniformGrid>
       <CheckBox Content="程序启动后运行一次" IsChecked="{Binding RunOnStartup}" Margin="0,0,0,9"/>
       <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>
       <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions>
        <CheckBox Content="自动检测" IsChecked="{Binding AutoDetect}"/><TextBox Grid.Column="1" Text="{Binding DetectInterval, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AutoDetect}" Style="{StaticResource GlassNumericUpDownStyle}" AutomationProperties.Name="检测间隔秒" MaxLength="4"/><TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
       </Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="101"/></Grid.ColumnDefinitions><CheckBox Content="每天定时执行" IsChecked="{Binding ScheduledLogin}"/><TextBox Grid.Column="1" Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ScheduledLogin}" AutomationProperties.Name="每天执行时间 HH:mm" MaxLength="5"/></Grid>
      </StackPanel>
     </animations:BeamBorder>
     <TextBlock Text="仅在发现认证门户时提交登录，已联网时自动跳过。" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="2,12,0,8" TextWrapping="Wrap"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="74"/><ColumnDefinition Width="10"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
    <Button Content="测试登录" Command="{Binding TestCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}"/><Button Grid.Column="3" Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"/>
   </Grid>
  </Grid>
 </Grid>
</Grid></Border></Window>
