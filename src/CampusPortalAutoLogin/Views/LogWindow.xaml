<Window x:Class="CampusPortalAutoLogin.Views.LogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CampusPortalAutoLogin.Views" xmlns:animations="clr-namespace:CampusPortalAutoLogin.Animations" Title="校园网自动登录 · 日志" Width="920" Height="640" MinWidth="660" MinHeight="440" ResizeMode="CanResize" Style="{StaticResource GlassWindowStyle}">
 <Border x:Name="WindowBorder" CornerRadius="24" BorderThickness="1" BorderBrush="#26FFFFFF" Background="{DynamicResource BackgroundBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Canvas x:Name="Lights" Grid.RowSpan="2" IsHitTestVisible="False" Opacity=".7"><Canvas.Effect><BlurEffect Radius="60"/></Canvas.Effect><Ellipse Width="560" Height="360" Fill="{x:Static animations:GlassMaterial.Moonlight}" Canvas.Top="-190" Canvas.Left="-120"/><Ellipse Width="360" Height="300" Fill="{x:Static animations:GlassMaterial.SteelLight}" Canvas.Top="300" Canvas.Left="600"/><Ellipse Width="180" Height="180" Fill="{x:Static animations:GlassMaterial.WarmLight}" Canvas.Top="-60" Canvas.Left="680"/></Canvas><Rectangle Grid.RowSpan="2" Fill="{x:Static animations:GlassMaterial.Noise}" IsHitTestVisible="False"/><Canvas x:Name="CursorLayer" Grid.RowSpan="2" IsHitTestVisible="False"><Ellipse x:Name="CursorAura" Width="96" Height="96" Fill="{StaticResource CursorAuraBrush}"/></Canvas><views:WindowTitleBar/><Grid Grid.Row="1">
 <Grid x:Name="Surface" Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="CONNECTION JOURNAL" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,7"/><TextBlock x:Name="HeroTitle" Text="连接异常，在这里排查。" FontSize="24" FontWeight="SemiBold"/></StackPanel><TextBlock Text="登录成功后自动清空" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14"><ComboBox x:Name="Filter" Width="125" SelectionChanged="FilterChanged" SelectedIndex="0"><ComboBoxItem Content="全部"/><ComboBoxItem Content="信息"/><ComboBoxItem Content="成功"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="错误"/></ComboBox><CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" Margin="18,0,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制选中" Click="Copy" Margin="0,0,8,0"/><Button Content="刷新" Click="Refresh"/></StackPanel></DockPanel>
  <animations:BeamBorder Grid.Row="2" CornerRadius="24" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
   <Grid><ListBox x:Name="Entries" Style="{StaticResource GlassLogViewerStyle}" SelectionMode="Extended"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,6"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat=MM-dd HH:mm:ss}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding Source}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="LoadingText" Text="正在读取本地记录…" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
  </animations:BeamBorder>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="打开日志目录 ↗" Click="OpenDirectory"/><TextBlock x:Name="CountText" Text="本地记录" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/><Button Content="清空日志" HorizontalAlignment="Right" Click="Clear"/></DockPanel>
 </Grid></Grid>
</Grid></Border></Window>
